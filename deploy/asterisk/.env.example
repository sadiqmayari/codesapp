# Asterisk container env — copy to .env on the VPS (NEVER commit the real one).
# These substitute the ${...} placeholders in config/*.conf.

# VPS public IPv4 (NAT external media/signalling address).
PUBLIC_IP=72.62.127.176

# Normalized business WhatsApp number, +E.164 (the number SIP is enabled on).
BUSINESS_NUMBER=+9230XXXXXXXX

# Meta-generated SIP password:
#   GET /<PHONE_NUMBER_ID>/settings?include_sip_credentials=true
#   -> calling.sip.servers[0].sip_user_password
META_SIP_PASSWORD=

# Agent softphone secret (first bring-up; CallsModule provisions real ones later).
AGENT1_SECRET=

# CodesApp call-event webhook (optional — the dialplan System()/curl posts here).
# Excluded from the /api prefix like other webhooks; secret-gated.
CALLS_WEBHOOK_URL=https://apps.codentra.pk/api/calls/events
CALLS_WEBHOOK_SECRET=
