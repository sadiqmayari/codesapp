// CodesApp — Prisma Schema
// Source of truth: SCHEMA.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  super_admin
  owner
  admin
  agent
}

enum UserStatus {
  pending
  active
  suspended
}

enum ActivationStatus {
  pending
  active
  suspended
}

enum UsageLimitAction {
  block
  warn_only
}

enum ContactStatus {
  active
  blocked
  archived
}

enum ConversationStatus {
  open
  resolved
  pending
}

enum MessageType {
  text
  image
  audio
  video
  document
  template
  sticker
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageStatus {
  sent
  delivered
  read
  failed
  // Outbound media persisted before the Meta upload+send completes (async
  // send-media queue). Flips to `sent`/`failed` when the worker gets Meta's ack.
  sending
  // WhatsApp emits `played` when the recipient plays a voice note / view-once
  // media — a step beyond `read`. Stored so we capture "voice note played"
  // receipts; the UI renders it like `read` (blue double tick). Appended LAST
  // so the DB enum change is metadata-only (no table rewrite) on MariaDB.
  played
}

enum TemplateCategory {
  marketing
  utility
  authentication
}

enum TemplateStatus {
  pending
  approved
  rejected
  paused
}

enum BotTriggerType {
  exact
  contains
  regex
}

enum BotStatus {
  active
  inactive
}

enum BroadcastStatus {
  draft
  scheduled
  sending
  completed
  failed
  cancelled
}

enum WebhookEndpointStatus {
  active
  inactive
}

enum WebhookDeliveryStatus {
  pending
  success
  failed
}

enum InvoiceStatus {
  pending
  paid
  overdue
  cancelled
}

enum ShopifyStatus {
  active
  inactive
  error
}

enum JobStatus {
  pending
  processing
  completed
  failed
}

enum CourierType {
  trax
  leopards
  postex
  rocket
}

enum ShipmentStatus {
  booked
  in_transit
  out_for_delivery
  picked_up
  ready_for_pickup
  delivered
  attempted
  failed
  address_issue
  cancelled
  returned
}

// ─── Tables ───────────────────────────────────────────────────────────────────

model Subscription {
  id              Int     @id @default(autoincrement())
  plan_name       String
  contact_limit   Int
  template_limit  Int
  user_limit      Int
  monthly_price   Decimal @db.Decimal(10, 2)
  setup_fee       Decimal @db.Decimal(10, 2)
  webhook_enabled Boolean @default(true)

  // Public pricing-card fields (landing page, super-admin controlled).
  is_public      Boolean @default(false)
  display_order  Int     @default(0)
  is_highlighted Boolean @default(false)
  tagline        String? @db.VarChar(160)
  features       Json?
  cta_label      String? @db.VarChar(40)
  currency       String  @default("PKR") @db.VarChar(8)
  billing_period String  @default("month") @db.VarChar(16)

  // AI Copilot plan gate. Effective AI access = plan.ai_enabled AND
  // company.ai_enabled. Defaults false so AI is opt-in per plan.
  ai_enabled              Boolean @default(false)
  // Feature-governance plan gate for proactive Shopify->WhatsApp automations
  // (delivery updates, cart recovery). Effective = plan.proactive_notifications
  // AND the tenant toggle. Default false (opt-in per plan tier).
  proactive_notifications Boolean @default(false)

  companies Company[]

  @@map("subscriptions")
}

model Company {
  id                               Int               @id @default(autoincrement())
  company_name                     String
  address                          String?
  subscription_id                  Int
  activation_status                ActivationStatus  @default(pending)
  waba_id                          String?
  phone_number_id                  String?
  onboarding_status                Json              @default("{}")
  // Option B (per-tenant own Meta app): each company configures its own
  // Meta app secret + webhook verify token and gets a unique callback URL
  // /webhooks/meta/{webhook_key}. NULL → fall back to platform META_* env
  // (the future Tech-Provider / Embedded-Signup path).
  webhook_key                      String?           @unique @db.VarChar(160)
  webhook_app_secret_encrypted     String?           @db.Text
  webhook_verify_token             String?           @db.VarChar(255)
  // Per-tenant Shopify webhook (client's own custom Shopify app): unique
  // callback URL /webhooks/shopify/{shopify_webhook_key}; the client's
  // Shopify webhook signing secret is stored encrypted for HMAC verify.
  shopify_webhook_key              String?           @unique @db.VarChar(160)
  shopify_webhook_secret_encrypted String?           @db.Text
  // Client's Shopify custom-app Admin API access token (AES-GCM) — used to
  // tag the order back when the customer taps Confirm/Cancel (write_orders).
  shopify_admin_token_encrypted    String?           @db.Text
  // Default country code for normalizing inbound/Shopify phone numbers
  // (e.g. "92"); NULL → code falls back to "92".
  default_country_code             String?           @db.VarChar(8)
  // Shell-Polish-A: company branding logo. Web path /storage/branding/{id}/logo.{ext}
  logo_url                         String?           @db.VarChar(500)
  // Billing-Lifecycle: 30-day billing cycle anchor. Set once on FIRST
  // super-admin activation; never overwritten on reactivation so the
  // cycle never drifts. NULL → not yet activated (no invoicing).
  activated_at                     DateTime?
  // Set when the auto-suspend cron deactivates for non-payment (audit/trace).
  suspended_at                     DateTime?
  // Super-admin "extra time" override. While in the future, the
  // auto-suspend cron skips this company even with an overdue invoice.
  grace_until                      DateTime?
  // Per-company override for behavior when a plan usage limit is hit.
  // NULL → fall back to the platform-wide default (PlatformSetting).
  usage_limit_action               UsageLimitAction?
  // IANA timezone name (e.g. "Asia/Karachi", "Europe/London"). Frontend
  // date/time helpers read this so timestamps render in the tenant's own
  // clock rather than the agent/admin's browser clock. NULL = browser default.
  timezone                         String?           @db.VarChar(64)
  // Phase 4: per-client editable limit overrides — beat the plan defaults.
  // NULL on any of these = use the subscription's value for that dimension.
  // The Enterprise plan can ship with placeholder defaults and be tuned
  // per-client via these overrides (override ?? subscription.<field>).
  contact_limit_override           Int?
  template_limit_override          Int?
  user_limit_override              Int?
  // AI Copilot per-company settings. ai_enabled is the tenant's own on/off
  // toggle (effective access also requires the plan's ai_enabled). brand_tone
  // shapes the assistant's voice; default_language drives translate/replies.
  // ai_monthly_cap_cents = owner/super-admin spend cap for the month
  // (billed amount, post-markup); NULL → platform default (0 = unlimited).
  ai_enabled                       Boolean           @default(true)
  ai_brand_tone                    String?           @db.VarChar(2000)
  ai_default_language              String?           @db.VarChar(32)
  ai_monthly_cap_cents             Int?
  // Phase 2: fully-automated AI auto-responder. When true, an inbound message
  // that no keyword bot handled (and where no human is assigned) is answered
  // by the AI inside the 24h window — confidence-gated (hands off to a human
  // when unsure). Default false (opt-in).
  ai_autoreply_enabled             Boolean           @default(false)
  // Phase 3: fully-automated AI ORDER creation (Shopify). When true, an
  // autopilot conversation where the customer clearly CONFIRMS a complete order
  // (items + name + phone + address) has the order created automatically; if
  // the order is confirmed but incomplete the AI hands off to a human instead
  // of creating a wrong order. Default false (opt-in, requires Shopify + AI).
  ai_auto_order_enabled            Boolean           @default(false)
  // June-2026 AI batch: broadens auto-order scope. When true (and workspace
  // ai_autoreply_enabled is on), EVERY chat the AI auto-replies to also
  // auto-creates orders on customer request — not just per-chat auto-piloted
  // chats. ai_auto_order_enabled remains the master switch. Default false.
  ai_auto_order_all_enabled        Boolean           @default(false)
  // Multimodal AI (now TENANT-controlled in Settings → AI, owner/admin only —
  // they pay for it). ai_vision_enabled = let the AI read inbound product images.
  // ai_voice_enabled = transcribe inbound voice notes (Whisper) into the AI
  // context. Both off by default. The super-admin kill-switch ai_premium_locked
  // (below) overrides BOTH back to off regardless of the tenant's choice.
  ai_vision_enabled                Boolean           @default(false)
  ai_voice_enabled                 Boolean           @default(false)
  // Tenant-selectable autonomous AI model tier ('fast' = Standard, 'smart' =
  // High-accuracy). NULL = follow the platform default (platform_settings
  // ai_autonomous_tier). Governs ONLY the autonomous auto-reply + auto-order
  // draft (the cost driver); interactive features keep fixed tiers. Resolved via
  // common/utils/ai-capabilities.ts.
  ai_autonomous_tier               String?           @db.VarChar(16)
  // Super-admin per-tenant kill-switch. When true, forces the tenant back to
  // baseline (Standard tier, no vision, no voice) regardless of their choices —
  // the surgical valve for abuse / non-payment. Default false.
  ai_premium_locked                Boolean           @default(false)
  // ── Feature Governance Framework (2026-06) ────────────────────────────────
  // Super-admin per-tenant force-on/off map { "<feature>": "on" | "off" },
  // resolved by FeatureService ABOVE the tenant flag (the authority layer).
  // NULL = no overrides → normal plan+tenant resolution. See
  // common/services/feature.service.ts + common/features/feature.constants.ts.
  feature_overrides                Json?
  // Engagement-engine mode for THIS tenant: 'shadow' | 'on'. NULL = follow the
  // platform default (platform_settings engagement_engine_mode). Lets super-admin
  // run one tenant 'on' for staged validation while others stay shadow/off.
  engagement_mode                  String?           @db.VarChar(16)
  // Tenant toggle for proactive Shopify->WhatsApp notifications. Effective also
  // requires the plan's proactive_notifications (and no super-admin force-off).
  // Default false (opt-in).
  proactive_notifications_enabled  Boolean           @default(false)
  created_at                       DateTime          @default(now())

  subscription         Subscription         @relation(fields: [subscription_id], references: [id])
  users                User[]
  contacts             Contact[]
  conversations        Conversation[]
  messages             Message[]
  templates            Template[]
  bots                 Bot[]
  broadcasts           Broadcast[]
  webhook_endpoints    WebhookEndpoint[]
  webhook_logs         WebhookLog[]
  invoices             Invoice[]
  audit_logs           AuditLog[]
  usage_metering       UsageMetering[]
  shopify_integrations ShopifyIntegration[]
  canned_replies       CannedReply[]
  ai_knowledge_base    AiKnowledgeBase[]
  ai_knowledge_chunks  AiKnowledgeChunk[]
  ai_usage_log         AiUsageLog[]
  support_tickets      SupportTicket[]
  plan_change_requests PlanChangeRequest[]

  @@map("companies")
}

model User {
  id            Int        @id @default(autoincrement())
  company_id    Int?
  name          String
  email         String     @unique
  password_hash String
  role          UserRole
  status        UserStatus @default(pending)
  totp_secret   String?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  company                Company?        @relation(fields: [company_id], references: [id])
  assigned_conversations Conversation[]  @relation("AssignedUser")
  assigned_tickets       SupportTicket[] @relation("AssignedTicketUser")
  audit_logs             AuditLog[]
  sent_messages          Message[]       @relation("MessageSender")

  @@map("users")
}

model Contact {
  id              Int           @id @default(autoincrement())
  company_id      Int
  name            String
  phone           String
  email           String?
  tags            Json          @default("[]")
  custom_fields   Json          @default("{}")
  last_message_at DateTime?
  status          ContactStatus @default(active)
  deleted_at      DateTime?
  created_at      DateTime      @default(now())

  company       Company         @relation(fields: [company_id], references: [id])
  conversations Conversation[]
  tickets       SupportTicket[]

  @@index([company_id, phone])
  @@map("contacts")
}

model Conversation {
  id                      Int                @id @default(autoincrement())
  company_id              Int
  contact_id              Int
  assigned_user_id        Int?
  status                  ConversationStatus @default(open)
  last_message            String?            @db.Text
  // Set ONLY when a message is sent/received — the WhatsApp-style sort key
  // for the conversation list. updated_at is polluted by read/label/assign
  // writes (Prisma @updatedAt) so it must NOT drive list ordering.
  last_message_at         DateTime?
  // Shell-Polish-B: non-null = pinned (sticky-top in the inbox list).
  // Value is when it was pinned — most-recently-pinned sorts first among pins.
  pinned_at               DateTime?
  // Shell-Polish-B: "clear chat" soft marker. Thread fetch hides messages
  // with timestamp <= cleared_before. Reversible, no row deletes; new
  // inbound messages after the marker still show.
  cleared_before          DateTime?
  // Per-conversation AI auto-pilot override. null = follow the workspace
  // default (companies.ai_autoreply_enabled); true = force auto-reply on this
  // chat (overrides the "skip if a human is assigned" rule); false = mute
  // auto-reply for this chat. Set to false automatically on an AI handoff.
  ai_autoreply            Boolean?
  // Phase 3: set to the timestamp when the AI auto-created a Shopify order for
  // this conversation. Non-null = an auto-order already happened here; the
  // auto-order worker skips creating a second one (idempotency guard — agents
  // can still create more orders manually).
  ai_order_created_at     DateTime?
  // June-2026 AI batch: confirm-before-create. When the AI has extracted a
  // COMPLETE order it stores the draft here and sends the customer a summary to
  // confirm; the order is only created after the customer affirms. Cleared once
  // created/declined. ai_pending_order_at stamps when it was raised (TTL guard).
  ai_pending_order        Json?
  ai_pending_order_at     DateTime?
  // Reorder-safe duplicate guard: signature (sorted items+qty) of the LAST order
  // the AI created in this conversation, paired with ai_order_created_at as the
  // last-order timestamp. A new create is blocked ONLY if the same signature was
  // created within a short window (mechanical double-fire); a different cart, or a
  // later re-confirmed reorder, is allowed. Replaces the old permanent lock.
  ai_last_order_signature String?            @db.VarChar(255)
  // Set when the AI sent a closing/sign-off after the customer ended the chat
  // ("ok thanks", "kuch nahi chahiye"). While set, further acknowledgements get
  // NO reply (no loop). Cleared when the customer makes a real new request.
  ai_closed_at            DateTime?
  // Prepaid flow (Rule 4): set when the AI has sent the customer bank details and
  // is waiting for a payment slip. While set, an inbound image/document is treated
  // as the slip → "verifying" + handoff to a human. Cleared on handoff.
  ai_awaiting_payment_at  DateTime?
  // Topic-Aware Commerce: the current conversation TOPIC (ActiveTopic enum value:
  // NONE|SALES|ORDER_CREATION|ORDER_TRACKING|DISPUTE|SUPPORT|HUMAN_HANDOFF),
  // derived from triage and used to scope context + gate state. null = none yet.
  ai_active_topic         String?            @db.VarChar(24)
  // When the current topic started, and (ORDER_TRACKING only) when it expires —
  // after a tracking session times out (30 min) the next message reclassifies.
  ai_topic_started_at     DateTime?
  ai_topic_expires_at     DateTime?
  // Episode boundary: the AUTONOMOUS transcript is lower-bounded by this so a new
  // commerce journey never sees the previous one's order/tracking replies.
  ai_episode_started_at   DateTime?
  // The Shopify order name/id this episode is about (e.g. for a tracking session
  // or a repeat-order seed). Cleared when the topic moves off ORDER_TRACKING.
  ai_linked_order_id      String?            @db.VarChar(64)
  // Click-to-WhatsApp attribution. When a chat starts from a Meta ad or a
  // FB/IG post link, the FIRST inbound message carries a `referral` object.
  // We store it FIRST-TOUCH (never overwritten) so the origin ad/post is
  // preserved for the life of the conversation. `referral` = the full payload
  // (headline, body, source_type/id/url, media urls, our downloaded thumb_path,
  // ctwa_clid). `referral_source_id` is the ad/post id, indexed for attribution
  // grouping; `referral_at` is when the referred chat started.
  referral                Json?
  referral_source_id      String?            @db.VarChar(191)
  referral_at             DateTime?
  window_expires_at       DateTime?
  unread_count            Int                @default(0)
  deleted_at              DateTime?
  created_at              DateTime           @default(now())
  updated_at              DateTime           @updatedAt

  company       Company             @relation(fields: [company_id], references: [id])
  contact       Contact             @relation(fields: [contact_id], references: [id])
  assigned_user User?               @relation("AssignedUser", fields: [assigned_user_id], references: [id])
  messages      Message[]
  labels        ConversationLabel[]
  notes         ConversationNote[]
  tickets       SupportTicket[]

  @@index([company_id, status, updated_at(sort: Desc)])
  @@index([company_id, last_message_at(sort: Desc)])
  @@index([company_id, pinned_at(sort: Desc)])
  @@index([company_id, referral_source_id])
  @@map("conversations")
}

model ConversationLabel {
  id              Int      @id @default(autoincrement())
  company_id      Int
  conversation_id Int
  label           String   @db.VarChar(64)
  created_at      DateTime @default(now())

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@unique([conversation_id, label])
  @@index([company_id, conversation_id])
  @@map("conversation_labels")
}

// Order Idempotency Protection (#2). A cross-path, cross-conversation fingerprint
// ledger that prevents duplicate Shopify orders from queue retries, worker
// crashes, duplicated webhooks, or ambiguous Shopify timeouts. The
// UNIQUE(company_id, hash) is the ATOMIC race guard — see OrderIdempotencyService.
model PendingOrderHash {
  id                 Int      @id @default(autoincrement())
  company_id         Int
  conversation_id    Int?
  hash               String   @db.Char(64)
  status             String   @default("in_flight") @db.VarChar(16)
  order_gid          String?  @db.VarChar(64)
  order_name         String?  @db.VarChar(64)
  admin_url          String?  @db.VarChar(512)
  // Agent who created this order via the Create-order modal (null for AI-auto
  // and storefront-direct orders). The orders/create webhook reads it back by
  // order_gid to stamp messages.user_id on the confirmation, so "orders per
  // agent" in analytics counts only orders an agent actually created.
  created_by_user_id Int?
  created_at         DateTime @default(now())
  expires_at         DateTime

  @@unique([company_id, hash])
  @@index([expires_at])
  @@index([company_id, conversation_id])
  @@map("pending_order_hashes")
}

// Handoff SLA Management (#10). One row per AI→human handoff with a deterministic
// priority + SLA deadline; the sweep marks picked-up handoffs resolved and alerts
// on breaches. See HandoffSlaService. Additive — flag-gated recording.
model Handoff {
  id               Int       @id @default(autoincrement())
  company_id       Int
  conversation_id  Int
  reason           String    @db.VarChar(255)
  reason_category  String    @db.VarChar(32)
  priority         String    @db.VarChar(16)
  assigned_user_id Int?
  sla_due_at       DateTime
  handoff_at       DateTime  @default(now())
  resolved_at      DateTime?
  escalated_at     DateTime?
  created_at       DateTime  @default(now())

  @@index([company_id, conversation_id])
  @@index([resolved_at, escalated_at, sla_due_at])
  @@map("handoffs")
}

// Conversation State Machine (#1). One deterministic state row per conversation,
// written ONLY by the backend (ConversationStateService). Ships in shadow mode.
model ConversationState {
  id               Int       @id @default(autoincrement())
  company_id       Int
  conversation_id  Int       @unique
  current_state    String    @db.VarChar(32)
  locked_intent    String?   @db.VarChar(24)
  collected_fields Json?
  active_order_id  String?   @db.VarChar(64)
  active_ticket_id Int?
  expires_at       DateTime?
  last_updated_at  DateTime  @default(now()) @updatedAt
  created_at       DateTime  @default(now())

  @@index([company_id, current_state])
  @@map("conversation_states")
}

model ConversationNote {
  id              Int      @id @default(autoincrement())
  company_id      Int
  conversation_id Int
  user_id         Int
  body            String   @db.Text
  created_at      DateTime @default(now())

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([company_id, conversation_id])
  @@map("conversation_notes")
}

model Segment {
  id         Int      @id @default(autoincrement())
  company_id Int
  name       String   @db.VarChar(128)
  filter     Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([company_id])
  @@map("segments")
}

// Saved canned / quick replies — company-wide reusable composer snippets
// (shared across agents, like WhatsApp Business "Quick replies"). No Meta
// involvement: the body is just inserted into the composer textarea.
model CannedReply {
  id         Int      @id @default(autoincrement())
  company_id Int
  title      String   @db.VarChar(120)
  body       String   @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company Company @relation(fields: [company_id], references: [id])

  @@index([company_id])
  @@map("canned_replies")
}

// Topic-Aware Commerce — dispute / support tickets. Opened by the AI (or an
// agent) when a customer raises a return / refund / exchange / damaged / wrong /
// missing-item / complaint issue. The AI only collects facts (order #, issue,
// photos) and NEVER promises, approves or rejects a refund — a human decides the
// outcome via the Tickets UI. Tenant-scoped (every query filters company_id).
model SupportTicket {
  id                Int       @id @default(autoincrement())
  company_id        Int
  conversation_id   Int
  contact_id        Int
  // Per-company human-friendly number, e.g. "DSP-1001".
  ticket_number     String    @db.VarChar(24)
  // refund|return|exchange|damaged|wrong_item|missing|complaint|other
  type              String    @db.VarChar(24)
  // open|in_progress|awaiting_customer|resolved|rejected
  status            String    @default("open") @db.VarChar(24)
  linked_order_name String?   @db.VarChar(64)
  description       String?   @db.Text
  // 'ai' | 'agent'
  created_by        String    @db.VarChar(16)
  assigned_user_id  Int?
  resolution_note   String?   @db.Text
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  closed_at         DateTime?

  company       Company       @relation(fields: [company_id], references: [id])
  conversation  Conversation  @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  contact       Contact       @relation(fields: [contact_id], references: [id])
  assigned_user User?         @relation("AssignedTicketUser", fields: [assigned_user_id], references: [id])
  events        TicketEvent[]

  @@unique([company_id, ticket_number])
  @@index([company_id, status])
  @@index([conversation_id])
  @@map("support_tickets")
}

// Append-only timeline for a SupportTicket.
model TicketEvent {
  id         Int      @id @default(autoincrement())
  company_id Int
  ticket_id  Int
  // created|note|photo_requested|photo_received|status_change|handoff
  kind       String   @db.VarChar(24)
  body       String?  @db.Text
  // 'ai' | 'agent' | 'customer'
  actor      String   @db.VarChar(16)
  user_id    Int?
  created_at DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([company_id, ticket_id])
  @@map("ticket_events")
}

// Tenant-initiated plan-change / upgrade requests. There is no payment gateway,
// so a tenant requests a plan and a super-admin reviews → on approve, the
// company's subscription is switched. One open (pending) request per company.
model PlanChangeRequest {
  id                        Int       @id @default(autoincrement())
  company_id                Int
  // The plan the tenant wants (null = "contact me / not sure, discuss").
  requested_subscription_id Int?
  // Snapshot of the plan they were on when requesting (for the review screen).
  current_subscription_id   Int?
  note                      String?   @db.Text
  // pending | approved | rejected | cancelled
  status                    String    @default("pending") @db.VarChar(16)
  created_by_user_id        Int?
  resolved_at               DateTime?
  resolution_note           String?   @db.Text
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  company Company @relation(fields: [company_id], references: [id])

  @@index([company_id, status])
  @@index([status])
  @@map("plan_change_requests")
}

// AI Copilot tenant knowledge base. Plain text entries (FAQs, policies,
// product info) injected — whole, prompt-cached — into the assistant's
// system context so replies/answers are grounded in the tenant's own data.
// No embeddings/RAG in v1 (small KBs fit the context budget).
model AiKnowledgeBase {
  id         Int      @id @default(autoincrement())
  company_id Int
  title      String   @db.VarChar(200)
  content    String   @db.Text
  enabled    Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company Company @relation(fields: [company_id], references: [id])

  @@index([company_id])
  @@map("ai_knowledge_base")
}

// RAG retrieval index. One row = one embedded chunk (a product, a store
// policy, etc.) so the AI can retrieve ONLY the few relevant chunks per
// question instead of injecting the whole catalogue. `embedding` is a raw
// little-endian Float32 buffer; cosine similarity is computed in-process
// (the corpus is small per tenant). Re-syncing replaces a source_type's rows.
model AiKnowledgeChunk {
  id          Int      @id @default(autoincrement())
  company_id  Int
  source_type String   @db.VarChar(32) // 'product' | 'policy'
  source_id   String   @db.VarChar(191) // shopify gid / policy key
  title       String   @db.VarChar(255)
  content     String   @db.Text
  // base64 of the little-endian Float32 vector (stored as text to avoid binary
  // serialization issues in the Prisma query protocol).
  embedding   String   @db.LongText
  dim         Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  company Company @relation(fields: [company_id], references: [id])

  @@unique([company_id, source_type, source_id])
  @@index([company_id])
  @@map("ai_knowledge_chunks")
}

// AI Copilot per-call usage ledger. One row per AI request — the
// authoritative record for post-paid billing (summed over the billing-cycle
// window) and the per-tenant usage breakdown. cost_micros = RAW provider
// cost in millionths of USD; markup applied at billing/display.
model AiUsageLog {
  id            Int      @id @default(autoincrement())
  company_id    Int
  user_id       Int?
  period        String   @db.VarChar(7)
  feature       String   @db.VarChar(32)
  model         String   @db.VarChar(64)
  input_tokens  Int      @default(0)
  output_tokens Int      @default(0)
  cost_micros   BigInt   @default(0)
  created_at    DateTime @default(now())

  company Company @relation(fields: [company_id], references: [id])

  @@index([company_id, created_at])
  @@map("ai_usage_log")
}

model Message {
  id                 Int              @id @default(autoincrement())
  conversation_id    Int
  company_id         Int
  broadcast_id       Int?
  message_type       MessageType      @default(text)
  direction          MessageDirection
  content            String?          @db.Text
  media_url          String?
  meta_media_url     String?
  media_expires_at   DateTime?
  media_expired      Boolean          @default(false)
  // June-2026 AI batch: cached Whisper transcription of an inbound voice note
  // (message_type='audio'). Filled lazily the first time the AI builds context
  // for a voice-enabled tenant, so each note is transcribed at most once.
  transcription      String?          @db.Text
  status             MessageStatus    @default(sent)
  // Latest emoji reaction the CUSTOMER placed on THIS message (WhatsApp-style:
  // shown as a badge on the bubble, not a separate message). NULL = none/removed.
  reaction           String?          @db.VarChar(64)
  meta_message_id    String?          @unique
  read_at            DateTime?
  read_by_user_id    Int?
  context_message_id Int?
  // The agent who composed this outbound message. NULL for inbound,
  // broadcast-fired, and bot-fired messages. Enables real per-agent
  // attribution in analytics (replaces "current assignee" approximation).
  user_id            Int?
  // Engagement-engine Phase 1: the work item (engagement) this message belongs
  // to — identity-based context isolation. NULL = not yet routed / legacy. seq
  // is the per-conversation monotonic order. INT (not BigInt) on purpose: Message
  // is API-serialized and JSON.stringify throws on bigint.
  work_item_id       Int?
  seq                Int?
  // Client-generated id for an optimistic outbound send. Echoed back in the
  // created message + the `message.sent` socket payload so the inbox can
  // reconcile the optimistic (negative-id) bubble against the real row by
  // client_id — fixes the "sent twice until refresh" media duplicate. NULL for
  // inbound / bot / broadcast / legacy rows. No index on purpose: reconciliation
  // is entirely client-side, so nothing queries by it.
  client_id          String?          @db.VarChar(64)
  timestamp          DateTime
  created_at         DateTime         @default(now())

  company         Company      @relation(fields: [company_id], references: [id])
  conversation    Conversation @relation(fields: [conversation_id], references: [id])
  user            User?        @relation("MessageSender", fields: [user_id], references: [id])
  context_message Message?     @relation("MessageContext", fields: [context_message_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  replied_by      Message[]    @relation("MessageContext")

  @@index([conversation_id, timestamp(sort: Desc)])
  @@index([media_expires_at, media_expired])
  @@index([conversation_id, direction, status])
  @@index([broadcast_id])
  @@index([context_message_id])
  @@index([user_id])
  @@index([work_item_id, timestamp])
  @@index([conversation_id, seq])
  // Analytics range scans filter messages by (company_id, created_at); without
  // this the dashboard/analytics queries full-scanned the tenant's messages,
  // which is why picking a wider period was slow.
  @@index([company_id, created_at])
  @@map("messages")
}

// Engagement-engine Phase 1: a bounded unit of work (engagement) inside a
// conversation. Many can be OPEN at once (e.g. an ORDER + a DISPUTE), each with
// its own FSM `state` and hard-scoped message context. Relation-free on purpose
// (scalar FK columns; DB enforces the FKs) to avoid touching the large
// Conversation/Company/Contact/User relation lists.
model WorkItem {
  id               Int       @id @default(autoincrement())
  company_id       Int
  conversation_id  Int
  contact_id       Int
  type             String    @db.VarChar(16) // SALES|ORDER|TRACKING|DISPUTE|SUPPORT
  state            String    @db.VarChar(32) // per-type FSM state
  status           String    @default("OPEN") @db.VarChar(16) // OPEN|SNOOZED|RESOLVED|CANCELLED|EXPIRED
  priority         Int       @default(5) @db.TinyInt
  owner            String    @default("AI") @db.VarChar(8) // AI|HUMAN|SYSTEM
  external_ref     String?   @db.VarChar(64)
  assigned_user_id Int?
  expires_at       DateTime?
  last_activity_at DateTime  @default(now())
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  closed_at        DateTime?

  @@index([company_id, conversation_id, status])
  @@index([company_id, type, status])
  @@index([company_id, status, expires_at])
  @@map("work_items")
}

// Records facts already communicated to the customer for a work item so the AI
// does not restate identical order status / tracking numbers / quotes.
model ToldLedger {
  id           Int      @id @default(autoincrement())
  company_id   Int
  work_item_id Int
  fact_kind    String   @db.VarChar(32) // order_status|tracking_no|price_quote
  fact_hash    String   @db.VarChar(64)
  told_at      DateTime @default(now())

  @@unique([work_item_id, fact_kind, fact_hash])
  @@index([company_id])
  @@map("told_ledger")
}

model Template {
  id               Int              @id @default(autoincrement())
  company_id       Int
  meta_template_id String?
  name             String
  category         TemplateCategory @default(marketing)
  status           TemplateStatus   @default(pending)
  content          Json             @default("{}")
  rejection_reason String?
  deleted_at       DateTime?
  created_at       DateTime         @default(now())

  company    Company     @relation(fields: [company_id], references: [id])
  broadcasts Broadcast[]

  @@map("templates")
}

model Bot {
  id           Int            @id @default(autoincrement())
  company_id   Int
  name         String
  trigger_type BotTriggerType @default(exact)
  keyword      String
  actions      Json           @default("[]")
  status       BotStatus      @default(active)
  created_at   DateTime       @default(now())

  company Company @relation(fields: [company_id], references: [id])

  @@map("bots")
}

model Broadcast {
  id              Int             @id @default(autoincrement())
  company_id      Int
  template_id     Int
  name            String
  audience_filter Json            @default("{}")
  status          BroadcastStatus @default(draft)
  scheduled_at    DateTime?
  sent_count      Int             @default(0)
  delivered_count Int             @default(0)
  read_count      Int             @default(0)
  failed_count    Int             @default(0)
  created_at      DateTime        @default(now())

  company  Company  @relation(fields: [company_id], references: [id])
  template Template @relation(fields: [template_id], references: [id])

  @@map("broadcasts")
}

model WebhookEndpoint {
  id                   Int                   @id @default(autoincrement())
  company_id           Int
  endpoint_url         String
  secret_key_encrypted String
  events               Json                  @default("[]")
  status               WebhookEndpointStatus @default(active)
  created_at           DateTime              @default(now())

  company      Company      @relation(fields: [company_id], references: [id])
  webhook_logs WebhookLog[]

  @@map("webhook_endpoints")
}

model WebhookLog {
  id              Int                   @id @default(autoincrement())
  webhook_id      Int
  company_id      Int
  event_name      String
  payload         Json
  delivery_status WebhookDeliveryStatus @default(pending)
  http_status     Int?
  attempts        Int                   @default(0)
  next_retry_at   DateTime?
  created_at      DateTime              @default(now())

  company          Company         @relation(fields: [company_id], references: [id])
  webhook_endpoint WebhookEndpoint @relation(fields: [webhook_id], references: [id])

  @@index([delivery_status, next_retry_at])
  @@index([webhook_id, delivery_status, created_at(sort: Desc)])
  @@map("webhook_logs")
}

model Invoice {
  id             Int           @id @default(autoincrement())
  company_id     Int
  amount         Decimal       @db.Decimal(10, 2)
  status         InvoiceStatus @default(pending)
  due_date       DateTime
  paid_at        DateTime?
  invoice_number String?       @unique @db.VarChar(32)
  period         String?       @db.VarChar(7)
  description    String?       @db.Text
  plan_snapshot  Json?
  created_at     DateTime      @default(now())

  company Company @relation(fields: [company_id], references: [id])

  @@index([company_id, period])
  @@map("invoices")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  company_id Int?
  user_id    Int?
  action     String
  entity     String
  entity_id  Int?
  metadata   Json?
  ip_address String?
  created_at DateTime @default(now())

  company Company? @relation(fields: [company_id], references: [id])
  user    User?    @relation(fields: [user_id], references: [id])

  @@map("audit_logs")
}

// Billing-Lifecycle: single-row-per-key platform settings (super-admin
// controlled). Currently holds `usage_limit_action` (the platform-wide
// default when a company has no per-company override).
model PlatformSetting {
  key        String   @id @db.VarChar(64)
  value      String   @db.VarChar(255)
  updated_at DateTime @default(now()) @updatedAt

  @@map("platform_settings")
}

model UsageMetering {
  id                   Int      @id @default(autoincrement())
  company_id           Int
  period               String
  messages_sent        Int      @default(0)
  contacts_stored      Int      @default(0)
  templates_used       Int      @default(0)
  webhook_calls        Int      @default(0)
  conversations_opened Int      @default(0)
  // AI Copilot monthly rollup (fast cap/quota check + dashboards). The
  // authoritative per-call ledger is ai_usage_log; these are convenience
  // counters. cost is stored in MICRO-dollars (millionths of USD) of RAW
  // provider cost — token costs are sub-cent, so cents would round to zero.
  // Markup (platform_settings.ai_price_multiplier) is applied at billing.
  ai_requests          Int      @default(0)
  ai_input_tokens      Int      @default(0)
  ai_output_tokens     Int      @default(0)
  ai_cost_micros       BigInt   @default(0)
  // Phase 4.5: fire-once ledger for usage-limit notifications
  // (90 / 99 / 100). Stored as a JSON array of "dim:threshold" strings,
  // e.g. ["contacts:90","contacts:99","templates:90"]. Per-period — a new
  // row each new calendar month resets the ledger implicitly.
  thresholds_notified  Json?
  updated_at           DateTime @updatedAt

  company Company @relation(fields: [company_id], references: [id])

  @@unique([company_id, period])
  @@map("usage_metering")
}

model ShopifyIntegration {
  id                       Int           @id @default(autoincrement())
  company_id               Int           @unique
  shop_domain              String
  access_token_encrypted   String
  webhook_secret_encrypted String
  active_events            Json          @default("[]")
  status                   ShopifyStatus @default(active)
  created_at               DateTime      @default(now())
  updated_at               DateTime      @updatedAt

  company Company @relation(fields: [company_id], references: [id])

  @@map("shopify_integrations")
}

// Per-company Shopify order-confirmation config (Phase 3). On orders/create
// (Phase 4) we send `template_id` to the customer with variables filled from
// `variable_map` (template {{n}} -> a fixed Shopify order source key); the
// template's Confirm/Cancel quick-reply buttons tag the order with
// confirm_tag / cancel_tag.
model ShopifyOrderConfig {
  id                           Int      @id @default(autoincrement())
  company_id                   Int      @unique
  template_id                  Int?
  language_code                String?  @db.VarChar(16)
  variable_map                 Json     @default("{}")
  confirm_tag                  String   @default("confirmed") @db.VarChar(64)
  cancel_tag                   String   @default("cancelled") @db.VarChar(64)
  pending_tag                  String?  @db.VarChar(64)
  decision_window_minutes      Int?
  shop_domain                  String?  @db.VarChar(255)
  api_version                  String?  @db.VarChar(16)
  enabled                      Boolean  @default(false)
  // Part 3 — proactive notifications. Reuses the existing template-send path;
  // bound to a (generic) approved template for the orders/fulfilled event.
  // Gated by FeatureService.proactiveNotificationsEnabled (plan + tenant);
  // a null template = feature dark for this tenant.
  // Generalized delivery notifications. JSON map of event_key ->
  // { templateId, variableMap, enabled }. Events: order_fulfilled (shipped),
  // order_cancelled, out_for_delivery, delivered, attempted, failed, and
  // abandoned_cart. Master on/off is companies.proactive_notifications_enabled;
  // per-event enabled + an approved template gate each send. See
  // DELIVERY_EVENTS in shopify.service.
  delivery_notifications       Json?
  // Abandoned-cart recovery wait before the recovery template is sent
  // (minutes; default applied in code = 180 / 3h).
  abandoned_cart_delay_minutes Int?
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt

  @@map("shopify_order_configs")
}

// Links an outbound order-confirmation template message to the Shopify
// order, so a later Confirm/Cancel button reply (whose context references
// that message) can tag the right order via the Admin API.
model ShopifyOrderMessage {
  id                Int      @id @default(autoincrement())
  company_id        Int
  message_id        Int      @unique
  conversation_id   Int
  shopify_order_gid String   @db.VarChar(255)
  shop_domain       String   @db.VarChar(255)
  status            String   @default("pending") @db.VarChar(16)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@unique([company_id, shopify_order_gid])
  @@index([company_id])
  @@map("shopify_order_messages")
}

// Tracks Shopify abandoned checkouts so a delayed recovery template can be sent
// if the customer hasn't converted. A checkouts/create|update webhook upserts a
// 'pending' row + schedules a delayed job; orders/create flips the matching row
// to 'converted' (recovery then no-ops); the job sends + marks 'recovered'.
model ShopifyAbandonedCheckout {
  id             Int      @id @default(autoincrement())
  company_id     Int
  checkout_token String   @db.VarChar(128)
  phone          String?  @db.VarChar(32)
  recovery_url   String?  @db.Text
  contact_name   String?  @db.VarChar(255)
  email          String?  @db.VarChar(255)
  items_summary  String?  @db.Text
  status         String   @default("pending") @db.VarChar(16) // pending|recovered|converted|expired|superseded
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([company_id, checkout_token])
  @@index([company_id, status])
  @@map("shopify_abandoned_checkouts")
}

// Per-company, per-courier API credentials, encrypted via EncryptionService.
// One JSON blob per courier since each has a different credential shape
// (Trax bearer token, Leopards api_key+password, PostEx token, Rocket
// client/token/store IDs) — the adapter owns parsing its own shape.
model CourierCredential {
  id                       Int         @id @default(autoincrement())
  company_id               Int
  courier_type             CourierType
  credentials_encrypted    String      @db.Text
  webhook_secret_encrypted String?     @db.Text
  webhook_key              String      @db.VarChar(64)
  is_active                Boolean     @default(true)
  created_at               DateTime    @default(now())
  updated_at               DateTime    @updatedAt

  @@unique([company_id, courier_type])
  @@unique([webhook_key])
  @@map("courier_credentials")
}

// City name -> per-courier city code lookup. company_id NULL rows are the
// platform seed defaults (loaded from the tenant's existing sheet lookup
// tabs); a company_id-scoped row for the same (courier_type, city_name)
// overrides the seed. city_name is stored normalized (trim + lowercase).
model CourierCityMapping {
  id                 Int         @id @default(autoincrement())
  company_id         Int?
  courier_type       CourierType
  city_name          String      @db.VarChar(128)
  // Holds the value THIS courier expects for the city: a numeric id for
  // Trax/Leopards/Rocket, but PostEx's canonical city NAME for PostEx
  // (its API takes `cityName` and its city list has no code column). Sized
  // like city_name because those names run long — the longest real PostEx
  // entry is 37 chars ("LIAQAT NATIONAL BAGH AKA COMPANY BAGH"), which
  // overflowed the original VarChar(32).
  city_code          String      @db.VarChar(128)
  is_default_courier Boolean     @default(false)
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt

  @@unique([company_id, courier_type, city_name])
  @@index([courier_type, city_name])
  @@map("courier_city_mappings")
}

model LoadsheetBatch {
  id                   Int         @id @default(autoincrement())
  company_id           Int
  courier_type         CourierType
  status               String      @default("pending") @db.VarChar(16) // pending|generating|ready|failed
  courier_loadsheet_id String?     @db.VarChar(128)
  pdf_media_url        String?     @db.VarChar(500)
  shipment_count       Int         @default(0)
  error                String?     @db.Text
  created_by_user_id   Int?
  created_at           DateTime    @default(now())
  completed_at         DateTime?

  shipments Shipment[]

  @@index([company_id, courier_type, status])
  @@map("loadsheet_batches")
}

// Native replacement for the tenant's Google Sheet fulfillment row: one
// Shipment per Shopify order, tracking which courier it's booked with, its
// tracking number, and its delivery status. address_issue is a first-class
// state (the sheet only had a generic "wrong address" marker in its City
// Code column with no reason/follow-up) — set either by a courier's
// tracking webhook or by AddressQualityService before booking.
/// Local mirror of Shopify orders, so the fulfilment queue can be listed,
/// filtered and bulk-selected without hitting Shopify on every page load.
///
/// ANTI-DUPLICATION: `@@unique([company_id, shopify_order_gid])` is the single
/// source of identity — the same key `Shipment` and `ShopifyOrderMessage`
/// already use. All three writers (CodesApp order creation, the orders/*
/// webhooks, and the one-time import) go through ShopifyOrderSyncService
/// .upsertOrder, so an order created in CodesApp and then echoed back by the
/// orders/create webhook UPDATES this row instead of inserting a second one.
///
/// FIELD OWNERSHIP: everything below is Shopify-owned and refreshed on every
/// sync, EXCEPT `assigned_user_id` / `internal_note` (CodesApp-owned, never
/// clobbered) and `source` (write-once first-touch provenance).
model ShopifyOrder {
  id                    Int       @id @default(autoincrement())
  company_id            Int
  shopify_order_gid     String    @db.VarChar(255)
  order_name            String?   @db.VarChar(64)
  order_number          String?   @db.VarChar(32)
  // Fulfilment routing data (kept so booking needs no extra Shopify call).
  fulfillment_order_gid String?   @db.VarChar(255)
  customer_name         String?   @db.VarChar(255)
  phone                 String?   @db.VarChar(32)
  email                 String?   @db.VarChar(255)
  city                  String?   @db.VarChar(128)
  address1              String?   @db.Text
  address2              String?   @db.Text
  country_code          String?   @db.VarChar(8)
  // Money. `total_outstanding` is what a COD courier must collect (0 when the
  // order is already paid) — the fix for the hardcoded codAmount: 0.
  total_price           Decimal?  @db.Decimal(12, 2)
  total_outstanding     Decimal?  @db.Decimal(12, 2)
  currency              String?   @db.VarChar(8)
  financial_status      String?   @db.VarChar(32)
  fulfillment_status    String?   @db.VarChar(32)
  line_items            Json?
  line_items_summary    String?   @db.Text
  shopify_created_at    DateTime?
  cancelled_at          DateTime?
  // Write-once provenance: 'codesapp' | 'webhook' | 'import'.
  source                String?   @db.VarChar(16)
  // CodesApp-owned — never overwritten by a Shopify sync.
  assigned_user_id      Int?
  internal_note         String?   @db.Text
  synced_at             DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@unique([company_id, shopify_order_gid])
  @@index([company_id, fulfillment_status, cancelled_at])
  @@index([company_id, shopify_created_at])
  @@index([company_id, order_name])
  @@map("shopify_orders")
}

model Shipment {
  id                        Int            @id @default(autoincrement())
  company_id                Int
  shopify_order_gid         String         @db.VarChar(255)
  shopify_order_name        String?        @db.VarChar(64)
  shopify_fulfillment_gid   String?        @db.VarChar(255)
  conversation_id           Int?
  contact_id                Int?
  courier_type              CourierType
  courier_credential_id     Int?
  courier_tracking_number   String?        @db.VarChar(128)
  courier_city_code         String?        @db.VarChar(32)
  destination_city          String?        @db.VarChar(128)
  destination_address       String?        @db.Text
  status                    ShipmentStatus @default(booked)
  address_issue_reason      String?        @db.Text
  address_issue_notified_at DateTime?
  address_confirmed_at      DateTime?
  last_courier_status_raw   String?        @db.VarChar(128)
  loadsheet_batch_id        Int?
  booked_at                 DateTime?
  delivered_at              DateTime?
  cancelled_at              DateTime?
  booking_error             String?        @db.Text
  raw_last_webhook          Json?
  created_by_user_id        Int?
  created_at                DateTime       @default(now())
  updated_at                DateTime       @updatedAt

  loadsheet_batch LoadsheetBatch? @relation(fields: [loadsheet_batch_id], references: [id])

  @@unique([company_id, shopify_order_gid])
  @@index([company_id, status])
  @@index([company_id, courier_type, status, loadsheet_batch_id])
  @@index([courier_tracking_number])
  @@map("shipments")
}

model Job {
  id           Int       @id @default(autoincrement())
  queue_name   String    @db.VarChar(64)
  payload      Json
  status       JobStatus @default(pending)
  attempts     Int       @default(0)
  max_attempts Int       @default(3)
  run_at       DateTime  @default(now())
  locked_until DateTime?
  locked_by    String?
  last_error   String?   @db.Text
  completed_at DateTime?
  created_at   DateTime  @default(now())
  // Engagement-engine Phase 0: per-conversation single-flight + FIFO. Jobs that
  // share a non-null serial_key are claimed one-at-a-time (the claim query skips
  // a row whose serial_key already has a 'processing' sibling). NULL = legacy
  // fully-parallel behavior. dedup_key (UNIQUE) makes enqueue idempotent;
  // priority orders the claim (lower = sooner).
  serial_key   String?   @db.VarChar(64)
  dedup_key    String?   @unique @db.VarChar(128)
  priority     Int       @default(5) @db.TinyInt

  @@index([queue_name, status, run_at])
  @@index([queue_name, status, priority, run_at])
  @@index([serial_key, status])
  @@index([locked_until])
  @@map("jobs")
}

// Append-only event log — the audit trail, idempotency ledger, and recovery
// foundation for the engagement engine. Current-state tables remain the
// system-of-record; events are written alongside them (shadow at first).
model Event {
  id              BigInt   @id @default(autoincrement())
  company_id      Int
  aggregate_type  String   @db.VarChar(24) // CONVERSATION | WORK_ITEM | ORDER | TICKET
  aggregate_id    BigInt
  seq             Int // per-aggregate ordering
  type            String   @db.VarChar(48) // 'order.confirmed', 'ticket.opened', …
  actor_type      String   @db.VarChar(16) // CUSTOMER | AI | AGENT | SYSTEM | SHOPIFY | META
  actor_id        String?  @db.VarChar(64)
  payload         Json?
  idempotency_key String?  @db.VarChar(128)
  created_at      DateTime @default(now())

  @@unique([aggregate_type, aggregate_id, seq])
  @@unique([company_id, idempotency_key])
  @@index([company_id, aggregate_type, aggregate_id, seq])
  @@index([company_id, type, created_at])
  @@map("events")
}

// Reliable external side-effects (WhatsApp sends, Shopify calls). A command writes
// state + an outbox row in the same transaction; a sender delivers it with the
// idempotency_key so a crash-retry never double-delivers.
model Outbox {
  id              BigInt    @id @default(autoincrement())
  company_id      Int
  kind            String    @db.VarChar(24) // WHATSAPP_SEND | SHOPIFY_CALL
  idempotency_key String    @unique @db.VarChar(128)
  payload         Json
  state           String    @default("PENDING") @db.VarChar(16) // PENDING | SENT | FAILED
  attempts        Int       @default(0)
  provider_ref    String?   @db.VarChar(128)
  last_error      String?   @db.Text
  created_at      DateTime  @default(now())
  sent_at         DateTime?

  @@index([state, created_at])
  @@map("outbox")
}
