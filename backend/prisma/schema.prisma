// CodesApp — Prisma Schema
// Source of truth: SCHEMA.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  super_admin
  owner
  admin
  agent
}

enum UserStatus {
  pending
  active
  suspended
}

enum ActivationStatus {
  pending
  active
  suspended
}

enum UsageLimitAction {
  block
  warn_only
}

enum ContactStatus {
  active
  blocked
  archived
}

enum ConversationStatus {
  open
  resolved
  pending
}

enum MessageType {
  text
  image
  audio
  video
  document
  template
  sticker
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageStatus {
  sent
  delivered
  read
  failed
}

enum TemplateCategory {
  marketing
  utility
  authentication
}

enum TemplateStatus {
  pending
  approved
  rejected
  paused
}

enum BotTriggerType {
  exact
  contains
  regex
}

enum BotStatus {
  active
  inactive
}

enum BroadcastStatus {
  draft
  scheduled
  sending
  completed
  failed
  cancelled
}

enum WebhookEndpointStatus {
  active
  inactive
}

enum WebhookDeliveryStatus {
  pending
  success
  failed
}

enum InvoiceStatus {
  pending
  paid
  overdue
  cancelled
}

enum ShopifyStatus {
  active
  inactive
  error
}

enum JobStatus {
  pending
  processing
  completed
  failed
}

// ─── Tables ───────────────────────────────────────────────────────────────────

model Subscription {
  id              Int       @id @default(autoincrement())
  plan_name       String
  contact_limit   Int
  template_limit  Int
  user_limit      Int
  monthly_price   Decimal   @db.Decimal(10, 2)
  setup_fee       Decimal   @db.Decimal(10, 2)
  webhook_enabled Boolean   @default(true)

  // Public pricing-card fields (landing page, super-admin controlled).
  is_public       Boolean   @default(false)
  display_order   Int       @default(0)
  is_highlighted  Boolean   @default(false)
  tagline         String?   @db.VarChar(160)
  features        Json?
  cta_label       String?   @db.VarChar(40)
  currency        String    @default("PKR") @db.VarChar(8)
  billing_period  String    @default("month") @db.VarChar(16)

  companies       Company[]

  @@map("subscriptions")
}

model Company {
  id                Int              @id @default(autoincrement())
  company_name      String
  address           String?
  subscription_id   Int
  activation_status ActivationStatus @default(pending)
  waba_id           String?
  phone_number_id   String?
  onboarding_status Json             @default("{}")
  // Option B (per-tenant own Meta app): each company configures its own
  // Meta app secret + webhook verify token and gets a unique callback URL
  // /webhooks/meta/{webhook_key}. NULL → fall back to platform META_* env
  // (the future Tech-Provider / Embedded-Signup path).
  webhook_key                  String? @unique @db.VarChar(160)
  webhook_app_secret_encrypted String? @db.Text
  webhook_verify_token         String? @db.VarChar(255)
  // Per-tenant Shopify webhook (client's own custom Shopify app): unique
  // callback URL /webhooks/shopify/{shopify_webhook_key}; the client's
  // Shopify webhook signing secret is stored encrypted for HMAC verify.
  shopify_webhook_key              String? @unique @db.VarChar(160)
  shopify_webhook_secret_encrypted String? @db.Text
  // Client's Shopify custom-app Admin API access token (AES-GCM) — used to
  // tag the order back when the customer taps Confirm/Cancel (write_orders).
  shopify_admin_token_encrypted    String? @db.Text
  // Default country code for normalizing inbound/Shopify phone numbers
  // (e.g. "92"); NULL → code falls back to "92".
  default_country_code             String? @db.VarChar(8)
  // Shell-Polish-A: company branding logo. Web path /storage/branding/{id}/logo.{ext}
  logo_url                         String? @db.VarChar(500)
  // Billing-Lifecycle: 30-day billing cycle anchor. Set once on FIRST
  // super-admin activation; never overwritten on reactivation so the
  // cycle never drifts. NULL → not yet activated (no invoicing).
  activated_at                     DateTime?
  // Set when the auto-suspend cron deactivates for non-payment (audit/trace).
  suspended_at                     DateTime?
  // Super-admin "extra time" override. While in the future, the
  // auto-suspend cron skips this company even with an overdue invoice.
  grace_until                      DateTime?
  // Per-company override for behavior when a plan usage limit is hit.
  // NULL → fall back to the platform-wide default (PlatformSetting).
  usage_limit_action               UsageLimitAction?
  // IANA timezone name (e.g. "Asia/Karachi", "Europe/London"). Frontend
  // date/time helpers read this so timestamps render in the tenant's own
  // clock rather than the agent/admin's browser clock. NULL = browser default.
  timezone                         String? @db.VarChar(64)
  // Phase 4: per-client editable limit overrides — beat the plan defaults.
  // NULL on any of these = use the subscription's value for that dimension.
  // The Enterprise plan can ship with placeholder defaults and be tuned
  // per-client via these overrides (override ?? subscription.<field>).
  contact_limit_override           Int?
  template_limit_override          Int?
  user_limit_override              Int?
  created_at        DateTime         @default(now())

  subscription         Subscription          @relation(fields: [subscription_id], references: [id])
  users                User[]
  contacts             Contact[]
  conversations        Conversation[]
  messages             Message[]
  templates            Template[]
  bots                 Bot[]
  broadcasts           Broadcast[]
  webhook_endpoints    WebhookEndpoint[]
  webhook_logs         WebhookLog[]
  invoices             Invoice[]
  audit_logs           AuditLog[]
  usage_metering       UsageMetering[]
  shopify_integrations ShopifyIntegration[]
  canned_replies       CannedReply[]

  @@map("companies")
}

model User {
  id            Int        @id @default(autoincrement())
  company_id    Int?
  name          String
  email         String     @unique
  password_hash String
  role          UserRole
  status        UserStatus @default(pending)
  totp_secret   String?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  company              Company?       @relation(fields: [company_id], references: [id])
  assigned_conversations Conversation[] @relation("AssignedUser")
  audit_logs           AuditLog[]
  sent_messages        Message[]      @relation("MessageSender")

  @@map("users")
}

model Contact {
  id              Int           @id @default(autoincrement())
  company_id      Int
  name            String
  phone           String
  email           String?
  tags            Json          @default("[]")
  custom_fields   Json          @default("{}")
  last_message_at DateTime?
  status          ContactStatus @default(active)
  deleted_at      DateTime?
  created_at      DateTime      @default(now())

  company       Company        @relation(fields: [company_id], references: [id])
  conversations Conversation[]

  @@index([company_id, phone])
  @@map("contacts")
}

model Conversation {
  id               Int                @id @default(autoincrement())
  company_id       Int
  contact_id       Int
  assigned_user_id Int?
  status           ConversationStatus @default(open)
  last_message     String?            @db.Text
  // Set ONLY when a message is sent/received — the WhatsApp-style sort key
  // for the conversation list. updated_at is polluted by read/label/assign
  // writes (Prisma @updatedAt) so it must NOT drive list ordering.
  last_message_at  DateTime?
  // Shell-Polish-B: non-null = pinned (sticky-top in the inbox list).
  // Value is when it was pinned — most-recently-pinned sorts first among pins.
  pinned_at        DateTime?
  // Shell-Polish-B: "clear chat" soft marker. Thread fetch hides messages
  // with timestamp <= cleared_before. Reversible, no row deletes; new
  // inbound messages after the marker still show.
  cleared_before   DateTime?
  window_expires_at DateTime?
  unread_count     Int                @default(0)
  deleted_at       DateTime?
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt

  company       Company             @relation(fields: [company_id], references: [id])
  contact       Contact             @relation(fields: [contact_id], references: [id])
  assigned_user User?               @relation("AssignedUser", fields: [assigned_user_id], references: [id])
  messages      Message[]
  labels        ConversationLabel[]
  notes         ConversationNote[]

  @@index([company_id, status, updated_at(sort: Desc)])
  @@index([company_id, last_message_at(sort: Desc)])
  @@index([company_id, pinned_at(sort: Desc)])
  @@map("conversations")
}

model ConversationLabel {
  id              Int          @id @default(autoincrement())
  company_id      Int
  conversation_id Int
  label           String       @db.VarChar(64)
  created_at      DateTime     @default(now())

  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([company_id, conversation_id])
  @@unique([conversation_id, label])
  @@map("conversation_labels")
}

model ConversationNote {
  id              Int          @id @default(autoincrement())
  company_id      Int
  conversation_id Int
  user_id         Int
  body            String       @db.Text
  created_at      DateTime     @default(now())

  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([company_id, conversation_id])
  @@map("conversation_notes")
}

model Segment {
  id          Int      @id @default(autoincrement())
  company_id  Int
  name        String   @db.VarChar(128)
  filter      Json
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([company_id])
  @@map("segments")
}

// Saved canned / quick replies — company-wide reusable composer snippets
// (shared across agents, like WhatsApp Business "Quick replies"). No Meta
// involvement: the body is just inserted into the composer textarea.
model CannedReply {
  id          Int      @id @default(autoincrement())
  company_id  Int
  title       String   @db.VarChar(120)
  body        String   @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  company     Company  @relation(fields: [company_id], references: [id])

  @@index([company_id])
  @@map("canned_replies")
}

model Message {
  id               Int              @id @default(autoincrement())
  conversation_id  Int
  company_id       Int
  broadcast_id     Int?
  message_type     MessageType      @default(text)
  direction        MessageDirection
  content          String?          @db.Text
  media_url        String?
  meta_media_url   String?
  media_expires_at DateTime?
  media_expired    Boolean          @default(false)
  status           MessageStatus    @default(sent)
  meta_message_id  String?          @unique
  read_at          DateTime?
  read_by_user_id  Int?
  context_message_id Int?
  // The agent who composed this outbound message. NULL for inbound,
  // broadcast-fired, and bot-fired messages. Enables real per-agent
  // attribution in analytics (replaces "current assignee" approximation).
  user_id          Int?
  timestamp        DateTime
  created_at       DateTime         @default(now())

  company      Company      @relation(fields: [company_id], references: [id])
  conversation Conversation @relation(fields: [conversation_id], references: [id])
  user         User?        @relation("MessageSender", fields: [user_id], references: [id])
  context_message Message?   @relation("MessageContext", fields: [context_message_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  replied_by      Message[]  @relation("MessageContext")

  @@index([conversation_id, timestamp(sort: Desc)])
  @@index([media_expires_at, media_expired])
  @@index([conversation_id, direction, status])
  @@index([broadcast_id])
  @@index([context_message_id])
  @@index([user_id])
  @@map("messages")
}

model Template {
  id               Int              @id @default(autoincrement())
  company_id       Int
  meta_template_id String?
  name             String
  category         TemplateCategory @default(marketing)
  status           TemplateStatus   @default(pending)
  content          Json             @default("{}")
  rejection_reason String?
  deleted_at       DateTime?
  created_at       DateTime         @default(now())

  company    Company     @relation(fields: [company_id], references: [id])
  broadcasts Broadcast[]

  @@map("templates")
}

model Bot {
  id           Int            @id @default(autoincrement())
  company_id   Int
  name         String
  trigger_type BotTriggerType @default(exact)
  keyword      String
  actions      Json           @default("[]")
  status       BotStatus      @default(active)
  created_at   DateTime       @default(now())

  company Company @relation(fields: [company_id], references: [id])

  @@map("bots")
}

model Broadcast {
  id              Int             @id @default(autoincrement())
  company_id      Int
  template_id     Int
  name            String
  audience_filter Json            @default("{}")
  status          BroadcastStatus @default(draft)
  scheduled_at    DateTime?
  sent_count      Int             @default(0)
  delivered_count Int             @default(0)
  read_count      Int             @default(0)
  failed_count    Int             @default(0)
  created_at      DateTime        @default(now())

  company  Company  @relation(fields: [company_id], references: [id])
  template Template @relation(fields: [template_id], references: [id])

  @@map("broadcasts")
}

model WebhookEndpoint {
  id                    Int                   @id @default(autoincrement())
  company_id            Int
  endpoint_url          String
  secret_key_encrypted  String
  events                Json                  @default("[]")
  status                WebhookEndpointStatus @default(active)
  created_at            DateTime              @default(now())

  company      Company      @relation(fields: [company_id], references: [id])
  webhook_logs WebhookLog[]

  @@map("webhook_endpoints")
}

model WebhookLog {
  id              Int                   @id @default(autoincrement())
  webhook_id      Int
  company_id      Int
  event_name      String
  payload         Json
  delivery_status WebhookDeliveryStatus @default(pending)
  http_status     Int?
  attempts        Int                   @default(0)
  next_retry_at   DateTime?
  created_at      DateTime              @default(now())

  company          Company         @relation(fields: [company_id], references: [id])
  webhook_endpoint WebhookEndpoint @relation(fields: [webhook_id], references: [id])

  @@index([delivery_status, next_retry_at])
  @@index([webhook_id, delivery_status, created_at(sort: Desc)])
  @@map("webhook_logs")
}

model Invoice {
  id             Int           @id @default(autoincrement())
  company_id     Int
  amount         Decimal       @db.Decimal(10, 2)
  status         InvoiceStatus @default(pending)
  due_date       DateTime
  paid_at        DateTime?
  invoice_number String?       @unique @db.VarChar(32)
  period         String?       @db.VarChar(7)
  description    String?       @db.Text
  plan_snapshot  Json?
  created_at     DateTime      @default(now())

  company Company @relation(fields: [company_id], references: [id])

  @@index([company_id, period])
  @@map("invoices")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  company_id Int?
  user_id    Int?
  action     String
  entity     String
  entity_id  Int?
  metadata   Json?
  ip_address String?
  created_at DateTime @default(now())

  company Company? @relation(fields: [company_id], references: [id])
  user    User?    @relation(fields: [user_id], references: [id])

  @@map("audit_logs")
}

// Billing-Lifecycle: single-row-per-key platform settings (super-admin
// controlled). Currently holds `usage_limit_action` (the platform-wide
// default when a company has no per-company override).
model PlatformSetting {
  key        String   @id @db.VarChar(64)
  value      String   @db.VarChar(255)
  updated_at DateTime  @default(now()) @updatedAt

  @@map("platform_settings")
}

model UsageMetering {
  id                   Int      @id @default(autoincrement())
  company_id           Int
  period               String
  messages_sent        Int      @default(0)
  contacts_stored      Int      @default(0)
  templates_used       Int      @default(0)
  webhook_calls        Int      @default(0)
  conversations_opened Int      @default(0)
  // Phase 4.5: fire-once ledger for usage-limit notifications
  // (90 / 99 / 100). Stored as a JSON array of "dim:threshold" strings,
  // e.g. ["contacts:90","contacts:99","templates:90"]. Per-period — a new
  // row each new calendar month resets the ledger implicitly.
  thresholds_notified  Json?
  updated_at           DateTime @updatedAt

  company Company @relation(fields: [company_id], references: [id])

  @@unique([company_id, period])
  @@map("usage_metering")
}

model ShopifyIntegration {
  id                       Int           @id @default(autoincrement())
  company_id               Int           @unique
  shop_domain              String
  access_token_encrypted   String
  webhook_secret_encrypted String
  active_events            Json          @default("[]")
  status                   ShopifyStatus @default(active)
  created_at               DateTime      @default(now())
  updated_at               DateTime      @updatedAt

  company Company @relation(fields: [company_id], references: [id])

  @@map("shopify_integrations")
}

// Per-company Shopify order-confirmation config (Phase 3). On orders/create
// (Phase 4) we send `template_id` to the customer with variables filled from
// `variable_map` (template {{n}} -> a fixed Shopify order source key); the
// template's Confirm/Cancel quick-reply buttons tag the order with
// confirm_tag / cancel_tag.
model ShopifyOrderConfig {
  id            Int      @id @default(autoincrement())
  company_id    Int      @unique
  template_id   Int?
  language_code String?  @db.VarChar(16)
  variable_map  Json     @default("{}")
  confirm_tag   String   @default("confirmed") @db.VarChar(64)
  cancel_tag    String   @default("cancelled") @db.VarChar(64)
  pending_tag   String?  @db.VarChar(64)
  decision_window_minutes Int?
  shop_domain   String?  @db.VarChar(255)
  api_version   String?  @db.VarChar(16)
  enabled       Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("shopify_order_configs")
}

// Links an outbound order-confirmation template message to the Shopify
// order, so a later Confirm/Cancel button reply (whose context references
// that message) can tag the right order via the Admin API.
model ShopifyOrderMessage {
  id                Int      @id @default(autoincrement())
  company_id        Int
  message_id        Int      @unique
  conversation_id   Int
  shopify_order_gid String   @db.VarChar(255)
  shop_domain       String   @db.VarChar(255)
  status            String   @default("pending") @db.VarChar(16)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([company_id])
  @@map("shopify_order_messages")
}

model Job {
  id           Int       @id @default(autoincrement())
  queue_name   String    @db.VarChar(64)
  payload      Json
  status       JobStatus @default(pending)
  attempts     Int       @default(0)
  max_attempts Int       @default(3)
  run_at       DateTime  @default(now())
  locked_until DateTime?
  locked_by    String?
  last_error   String?   @db.Text
  completed_at DateTime?
  created_at   DateTime  @default(now())

  @@index([queue_name, status, run_at])
  @@index([locked_until])
  @@map("jobs")
}
