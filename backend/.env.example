# CodesApp — Backend Environment Variables
# Copy to .env and fill in all values before running

NODE_ENV=development
PORT=3001
APP_URL=https://apps.codentra.pk

# Database (MySQL 8)
DATABASE_URL=mysql://user:password@localhost:3306/codesapp

# JWT
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Meta WhatsApp Cloud API
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_GRAPH_VERSION=v19.0
META_CONVERSATION_FLAT_USD=0.005

# Shopify
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=

# Encryption (must be exactly 32 characters)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex').slice(0,32))"
ENCRYPTION_KEY=

# Cron (protects /cron/* routes from unauthorized calls)
CRON_SECRET=change-me-to-random-secret

# Super Admin
SUPER_ADMIN_EMAIL=admin@codentra.pk
SUPER_ADMIN_PASSWORD=
# Comma-separated IPs allowed to access /super-admin/* (bypassed in development)
SUPER_ADMIN_IP_WHITELIST=127.0.0.1

# SMTP (Hostinger email or any SMTP provider)
SMTP_HOST=mail.codentra.pk
SMTP_PORT=587
SMTP_USER=noreply@codentra.pk
SMTP_PASS=
SMTP_FROM="CodesApp <noreply@codentra.pk>"

# AI Copilot. Platform keys — cost is billed back to tenants (raw provider
# cost x platform_settings.ai_price_multiplier). The active provider is chosen
# in super-admin → Platform settings (platform_settings.ai_provider); set the
# key for whichever provider you select. AI endpoints return 503 until the
# active provider's key is present; the rest of the app is unaffected.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AI knowledge store (Postgres + pgvector). Optional: when unset, RAG retrieval
# falls back to the in-MariaDB base64 vectors + in-process cosine (fully
# working, just no hybrid search). On the VPS this points at the internal
# `postgres` service. Example:
#   PGVECTOR_URL=postgresql://codesapp:<password>@postgres:5432/codesapp_rag
PGVECTOR_URL=
