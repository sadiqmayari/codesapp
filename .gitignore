# Dependencies
node_modules/
**/node_modules/

# Environment secrets — NEVER commit
.env
**/.env
.env.local
**/.env.local

# Build outputs.
# backend/dist AND frontend/.next are committed (Hostinger shared hosting OOMs
# on a clean build — see ERRORS.md). Only the .next/cache dir is excluded.
.next/
**/.next/
!frontend/.next/
!frontend/.next/**
frontend/.next/cache/
frontend/dist/

# Media storage (large binary files)
storage/media/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Prisma generated client (generated on deploy via prisma generate)
backend/node_modules/.prisma/

# Test coverage
coverage/
**/coverage/

# Claude Code per-machine settings (not portable across devs)
.claude/
**/.claude/
