# Dependencies
node_modules/
**/node_modules/

# Environment secrets — NEVER commit
.env
**/.env
.env.local
**/.env.local

# Build outputs.
# Hostinger deploys ONLY the backend dir and OOMs on host builds, so the
# prebuilt frontend is committed at backend/web/.next (synced from
# frontend/.next via `npm run sync:web`), same pattern as backend/dist.
# frontend/.next stays ignored (local build artifact, not deployed).
.next/
**/.next/
!backend/dist/web/.next/
!backend/dist/web/.next/**
backend/dist/web/.next/cache/
frontend/dist/

# Media storage (large binary files)
storage/media/

# Database dumps / backups — contain real customer data, NEVER commit
*.sql
*.sql.gz
*.sql.zip

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Prisma generated client (generated on deploy via prisma generate)
backend/node_modules/.prisma/

# Test coverage
coverage/
**/coverage/

# Claude Code per-machine settings (not portable across devs)
.claude/
**/.claude/
.commitmsg.tmp
