# Dependencies
node_modules/
**/node_modules/

# Environment secrets — NEVER commit
.env
**/.env
.env.local
**/.env.local

# Build outputs — NOT committed anymore.
# Prod runs on the VPS where Docker rebuilds dist from source on every deploy
# (.dockerignore excludes backend/dist), so compiled output is never deployed
# from git. Tracking it only caused perpetual "uncommitted main" churn.
.next/
**/.next/
backend/dist/
frontend/dist/
*.tsbuildinfo

# Media storage (large binary files)
storage/media/

# Database dumps / backups — contain real customer data, NEVER commit.
# Root-level only, so Prisma migration .sql files (backend/prisma/migrations/**)
# are NOT ignored.
/*.sql
/*.sql.gz
/*.sql.zip

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Prisma generated client (generated on deploy via prisma generate)
backend/node_modules/.prisma/

# Test coverage
coverage/
**/coverage/

# Claude Code per-machine settings (not portable across devs)
.claude/
**/.claude/
.commitmsg.tmp
